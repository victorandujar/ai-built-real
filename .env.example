# Use your verified production origin, without a trailing slash.
SITE_URL=https://example.com
# Set true only after the launch checks in README pass.
PUBLIC_LAUNCH_READY=false
CONTACT_EMAIL=
RESEND_API_KEY=
# Verified sender in Resend, e.g. Brand <hello@your-domain.com>
RESEND_FROM=
# Optional shared rate limit: both Upstash REST values required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
