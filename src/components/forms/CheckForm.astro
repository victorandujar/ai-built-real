<div class="form-panel">
  <noscript
    ><p class="notice">
      Enable JavaScript to complete the request. Your details are only sent when
      you choose Send my request.
    </p></noscript
  ><form id="check-form" novalidate data-state="editing">
    <div class="form-top">
      <p class="eyebrow" id="step-label" aria-live="polite">
        01 / Your product
      </p><nav class="form-steps" aria-label="Request progress">
        <button
          type="button"
          data-go-step="0"
          aria-current="step"
          aria-label="Step 1: Your product">1</button
        ><button
          type="button"
          data-go-step="1"
          disabled
          aria-label="Step 2: Your next step">2</button
        ><button
          type="button"
          data-go-step="2"
          disabled
          aria-label="Step 3: Your details">3</button
        >
      </nav>
    </div><div class="form-progress" aria-hidden="true"><i></i></div><p
      class="step-guidance"
      id="step-guidance"
      role="status"
    >
      Three small steps. Start with your product.
    </p>
    <fieldset data-step="0">
      <legend tabindex="-1">First, your product.</legend><p
        class="step-caption"
      >
        The thing you made. And who you made it for.
      </p>
      <div class="field">
        <label for="productUrl">Product URL</label><input
          id="productUrl"
          name="productUrl"
          type="url"
          autocomplete="url"
          placeholder="https://your-product.com"
          required
          maxlength="2048"
          aria-describedby="productUrl-hint productUrl-error"
        /><p class="hint" id="productUrl-hint">
          A live link or a publicly accessible preview.
        </p><p class="field-error" id="productUrl-error" hidden></p>
      </div>
      <div class="field">
        <label for="description">What does your product do?</label><textarea
          id="description"
          name="description"
          placeholder="Who is it for? What does it help them do?"
          required
          minlength="10"
          maxlength="3000"
          aria-describedby="description-error"></textarea><p
          class="field-error"
          id="description-error"
          hidden
        >
        </p>
      </div>
      <div class="field">
        <label for="tool">What did you build it with?</label><select
          id="tool"
          name="tool"
          required
          aria-describedby="tool-error"
          ><option value="">Choose your main tool</option>{
            [
              'Lovable',
              'Cursor',
              'Replit',
              'Bolt',
              'Claude Code',
              'Codex',
              'v0',
              'Windsurf',
              'Other',
            ].map((t) => <option>{t}</option>)
          }</select
        ><p class="field-error" id="tool-error" hidden></p>
      </div>
    </fieldset>
    <fieldset data-step="1" hidden disabled>
      <legend tabindex="-1">Where are you headed?</legend><p
        class="step-caption"
      >
        So we can focus on what matters for your next step.
      </p><div class="field-grid">
        <div class="field">
          <label for="users">Do you already have users?</label><select
            id="users"
            name="users"
            required
            aria-describedby="users-error"
            ><option value="">Choose one</option><option>No</option><option
              >Beta users</option
            ><option>Yes</option></select
          ><p class="field-error" id="users-error" hidden></p>
        </div>
        <div class="field">
          <label for="payments">Taking payments?</label><select
            id="payments"
            name="payments"
            required
            aria-describedby="payments-error"
            ><option value="">Choose one</option><option>No</option><option
              >Soon</option
            ><option>Yes</option></select
          ><p class="field-error" id="payments-error" hidden></p>
        </div>
        <div class="field">
          <label for="data">Handles customer or personal data?</label><select
            id="data"
            name="data"
            required
            aria-describedby="data-error"
            ><option value="">Choose one</option><option>Yes</option><option
              >No</option
            ><option>Not sure</option></select
          ><p class="field-error" id="data-error" hidden></p>
        </div>
        <div class="field">
          <label for="next">What are you planning next?</label><select
            id="next"
            name="next"
            required
            aria-describedby="next-error"
            ><option value="">Choose one</option><option>Private testing</option
            ><option>Public beta</option><option>Launch</option><option
              >Start charging</option
            ><option>Scale existing users</option><option>Other</option></select
          ><p class="field-error" id="next-error" hidden></p>
        </div>
      </div><div class="field">
        <label for="uncertainty">What are you most unsure about?</label
        ><textarea
          id="uncertainty"
          name="uncertainty"
          placeholder="The thing you'd like a second pair of eyes on."
          required
          minlength="5"
          maxlength="3000"
          aria-describedby="uncertainty-error"></textarea><p
          class="field-error"
          id="uncertainty-error"
          hidden
        >
        </p>
      </div><div class="field">
        <label for="repository"
          >Repository URL <span class="muted">(optional)</span></label
        ><input
          id="repository"
          name="repository"
          type="url"
          maxlength="2048"
          aria-describedby="repository-hint repository-error"
        /><p class="hint" id="repository-hint">
          No access needed yet. Never include passwords, keys or customer
          records.
        </p><p class="field-error" id="repository-error" hidden></p>
      </div>
    </fieldset>
    <fieldset data-step="2" hidden disabled>
      <legend tabindex="-1">Let's put a name to it.</legend><p
        class="step-caption"
      >
        A real person will reply to you. No mailing lists.
      </p><div class="review-summary">
        <div class="review-heading">
          <span class="mono">Your brief</span><button
            type="button"
            id="edit-brief">Edit details ↗</button
          >
        </div><strong id="review-product"></strong><span id="review-stage"
        ></span>
      </div><div class="field">
        <label for="name">Your name</label><input
          id="name"
          name="name"
          required
          minlength="2"
          maxlength="100"
          autocomplete="name"
          aria-describedby="name-error"
        /><p class="field-error" id="name-error" hidden></p>
      </div><div class="field">
        <label for="email">Email</label><input
          id="email"
          name="email"
          type="email"
          required
          maxlength="254"
          autocomplete="email"
          aria-describedby="email-error"
        /><p class="field-error" id="email-error" hidden></p>
      </div><div class="field">
        <label class="check-label"
          ><input
            id="consent"
            type="checkbox"
            name="consent"
            required
            aria-describedby="consent-error"
          /><span
            >I have read the <a href="/privacy" class="underline"
              >privacy notice</a
            > and agree to be contacted about this request.</span
          ></label
        ><p class="field-error" id="consent-error" hidden></p>
      </div><p class="hint">
        Sending this request is free. We agree any paid work with you first.
      </p>
    </fieldset>
    <div class="hp" aria-hidden="true">
      <label for="website">Leave this field empty</label><input
        id="website"
        name="website"
        tabindex="-1"
        autocomplete="off"
      />
    </div>
    <div class="form-alert" id="form-error" role="alert" tabindex="-1" hidden>
      <strong id="error-title">Let's check that.</strong><p id="error-message">
      </p>
    </div><p id="sending-note" class="sending-note" role="status" hidden>
      <span class="spinner" aria-hidden="true"></span><span id="sending-message"
        >Sending your request. Please keep this tab open.</span
      >
    </p><div class="form-actions">
      <button type="button" class="back-button" id="back" hidden>← Back</button
      ><button type="button" class="button" id="next-button"
        ><span>Continue</span><span class="button-icon" aria-hidden="true"
          >→</span
        ></button
      ><button type="submit" class="button" id="submit" hidden
        ><span data-submit-label>Send my request</span><span
          class="button-icon"
          aria-hidden="true"><span data-submit-icon>↗</span></span
        ></button
      >
    </div>
  </form>
  <div class="success" id="form-success" role="status" tabindex="-1" hidden>
    <div class="success-mark" aria-hidden="true">
      <svg viewBox="0 0 30 30" width="30" height="30"
        ><path
          d="m7 15 5 5 12-12"
          stroke="currentColor"
          stroke-width="1.6"
          fill="none"></path></svg
      >
    </div><p class="eyebrow">Safely on the other side.</p><h2>
      Got it.<br />Now it's our turn.
    </h2><p class="muted mt-6">
      Your request is in. Víctor will review the product and reply to <strong
        id="success-email">the email you shared</strong
      >.
    </p><div class="success-next">
      <p>
        <strong>What happens next?</strong><br />A conversation about fit, scope
        and timing. No paid work starts without your agreement.
      </p>
    </div><a href="/learn" class="text-link mt-6"
      >A little clarity while you're here ↗</a
    >
  </div>
</div>
<script src="@/lib/check-form.ts"></script>
