---
import { useTranslations, path } from '@/i18n';
import type { Locale } from '@/i18n';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
/**
 * Option values stay in English because the lead schema validates against them.
 * Only the visible text is translated, via the `value` / label split.
 */
const tools = [
  'Lovable',
  'Cursor',
  'Replit',
  'Bolt',
  'Claude Code',
  'Codex',
  'v0',
  'Windsurf',
  'Other',
];
const toolLabels: Record<string, string> =
  lang === 'es' ? { Other: 'Otra' } : {};
const choices = (values: readonly string[], labels: readonly string[]) =>
  values.map((value, i) => ({ value, label: labels[i] ?? value }));
const users = choices(['No', 'Beta users', 'Yes'], t.form.options.users);
const payments = choices(['No', 'Soon', 'Yes'], t.form.options.payments);
const data = choices(['Yes', 'No', 'Not sure'], t.form.options.data);
const next = choices(
  [
    'Private testing',
    'Public beta',
    'Launch',
    'Start charging',
    'Scale existing users',
    'Other',
  ],
  t.form.options.next,
);
---

<div class="form-panel">
  <noscript><p class="notice">{t.form.noscript}</p></noscript><form
    id="check-form"
    novalidate
    data-state="editing"
  >
    <div class="form-top">
      <p class="eyebrow" id="step-label" aria-live="polite">
        01 / {t.form.stepNames[0]}
      </p><nav class="form-steps" aria-label={t.form.progressLabel}>
        {
          t.form.stepAria.map((aria, i) => (
            <button
              type="button"
              data-go-step={i}
              disabled={i > 0}
              aria-current={i === 0 ? 'step' : undefined}
              aria-label={aria}
            >
              {i + 1}
            </button>
          ))
        }
      </nav>
    </div><div class="form-progress" aria-hidden="true"><i></i></div><p
      class="step-guidance"
      id="step-guidance"
      role="status"
    >
      {t.form.guidance[0]}
    </p>
    <fieldset data-step="0">
      <legend tabindex="-1">{t.form.legends[0]}</legend><p class="step-caption">
        {t.form.captions[0]}
      </p>
      <div class="field">
        <label for="productUrl">{t.form.labels.productUrl}</label><input
          id="productUrl"
          name="productUrl"
          type="url"
          autocomplete="url"
          placeholder={t.form.placeholders.productUrl}
          required
          maxlength="2048"
          aria-describedby="productUrl-hint productUrl-error"
        /><p class="hint" id="productUrl-hint">{t.form.hints.productUrl}</p><p
          class="field-error"
          id="productUrl-error"
          hidden
        >
        </p>
      </div>
      <div class="field">
        <label for="description">{t.form.labels.description}</label><textarea
          id="description"
          name="description"
          placeholder={t.form.placeholders.description}
          required
          minlength="10"
          maxlength="3000"
          aria-describedby="description-error"></textarea><p
          class="field-error"
          id="description-error"
          hidden
        >
        </p>
      </div>
      <div class="field">
        <label for="tool">{t.form.labels.tool}</label><select
          id="tool"
          name="tool"
          required
          aria-describedby="tool-error"
          ><option value="">{t.form.chooseTool}</option>{
            tools.map((tool) => (
              <option value={tool}>{toolLabels[tool] ?? tool}</option>
            ))
          }</select
        ><p class="field-error" id="tool-error" hidden></p>
      </div>
    </fieldset>
    <fieldset data-step="1" hidden disabled>
      <legend tabindex="-1">{t.form.legends[1]}</legend><p class="step-caption">
        {t.form.captions[1]}
      </p><div class="field-grid">
        {
          [
            { id: 'users', label: t.form.labels.users, items: users },
            { id: 'payments', label: t.form.labels.payments, items: payments },
            { id: 'data', label: t.form.labels.data, items: data },
            { id: 'next', label: t.form.labels.next, items: next },
          ].map((field) => (
            <div class="field">
              <>
                <label for={field.id}>{field.label}</label>
                <select
                  id={field.id}
                  name={field.id}
                  required
                  aria-describedby={`${field.id}-error`}
                >
                  <>
                    <option value="">{t.form.chooseOne}</option>
                    {field.items.map((item) => (
                      <option value={item.value}>{item.label}</option>
                    ))}
                  </>
                </select>
                <p class="field-error" id={`${field.id}-error`} hidden />
              </>
            </div>
          ))
        }
      </div><div class="field">
        <label for="uncertainty">{t.form.labels.uncertainty}</label><textarea
          id="uncertainty"
          name="uncertainty"
          placeholder={t.form.placeholders.uncertainty}
          required
          minlength="5"
          maxlength="3000"
          aria-describedby="uncertainty-error"></textarea><p
          class="field-error"
          id="uncertainty-error"
          hidden
        >
        </p>
      </div><div class="field">
        <label for="repository"
          >{t.form.labels.repository}{' '}<span class="muted"
            >{t.form.labels.optional}</span
          ></label
        ><input
          id="repository"
          name="repository"
          type="url"
          maxlength="2048"
          aria-describedby="repository-hint repository-error"
        /><p class="hint" id="repository-hint">{t.form.hints.repository}</p><p
          class="field-error"
          id="repository-error"
          hidden
        >
        </p>
      </div>
    </fieldset>
    <fieldset data-step="2" hidden disabled>
      <legend tabindex="-1">{t.form.legends[2]}</legend><p class="step-caption">
        {t.form.captions[2]}
      </p><div class="review-summary">
        <div class="review-heading">
          <span class="mono">{t.form.brief}</span><button
            type="button"
            id="edit-brief">{t.form.editBrief} ↗</button
          >
        </div><strong id="review-product"></strong><span id="review-stage"
        ></span>
      </div><div class="field">
        <label for="name">{t.form.labels.name}</label><input
          id="name"
          name="name"
          required
          minlength="2"
          maxlength="100"
          autocomplete="name"
          aria-describedby="name-error"
        /><p class="field-error" id="name-error" hidden></p>
      </div><div class="field">
        <label for="email">{t.form.labels.email}</label><input
          id="email"
          name="email"
          type="email"
          required
          maxlength="254"
          autocomplete="email"
          aria-describedby="email-error"
        /><p class="field-error" id="email-error" hidden></p>
      </div><div class="field">
        <label class="check-label"
          ><input
            id="consent"
            type="checkbox"
            name="consent"
            required
            aria-describedby="consent-error"
          /><span
            >{t.form.consent.before}<a
              href={path('privacy', lang)}
              class="underline">{t.form.consent.link}</a
            >{t.form.consent.after}</span
          ></label
        ><p class="field-error" id="consent-error" hidden></p>
      </div><p class="hint">{t.form.hints.free}</p>
    </fieldset>
    <div class="hp" aria-hidden="true">
      <label for="website">{t.form.labels.honeypot}</label><input
        id="website"
        name="website"
        tabindex="-1"
        autocomplete="off"
      />
    </div>
    <div class="form-alert" id="form-error" role="alert" tabindex="-1" hidden>
      <strong id="error-title">{t.form.errorTitle}</strong><p
        id="error-message"
      >
      </p>
    </div><p id="sending-note" class="sending-note" role="status" hidden>
      <span class="spinner" aria-hidden="true"></span><span id="sending-message"
        >{t.form.sending}</span
      >
    </p><div class="form-actions">
      <button type="button" class="back-button" id="back" hidden
        >← {t.form.back}</button
      ><button type="button" class="button" id="next-button"
        ><span>{t.form.continue}</span><span
          class="button-icon"
          aria-hidden="true">→</span
        ></button
      ><button type="submit" class="button" id="submit" hidden
        ><span data-submit-label>{t.form.submit}</span><span
          class="button-icon"
          aria-hidden="true"><span data-submit-icon>↗</span></span
        ></button
      >
    </div>
  </form>
  <div class="success" id="form-success" role="status" tabindex="-1" hidden>
    <div class="success-mark" aria-hidden="true">
      <svg viewBox="0 0 30 30" width="30" height="30"
        ><path
          d="m7 15 5 5 12-12"
          stroke="currentColor"
          stroke-width="1.6"
          fill="none"></path></svg
      >
    </div><p class="eyebrow">{t.form.success.eyebrow}</p><h2>
      {t.form.success.title[0]}<br />{t.form.success.title[1]}
    </h2><p class="muted mt-6">
      {t.form.success.body.before}<strong id="success-email"
        >{t.form.success.body.fallback}</strong
      >{t.form.success.body.after}
    </p><div class="success-next">
      <p>
        <strong>{t.form.success.nextTitle}</strong><br />{
          t.form.success.nextCopy
        }
      </p>
    </div><a href={path('learn', lang)} class="text-link mt-6"
      >{t.form.success.link} ↗</a
    >
  </div>
</div>
<script src="@/lib/check-form.ts"></script>
