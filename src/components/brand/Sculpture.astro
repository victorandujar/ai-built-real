---
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="sculpture" id="sculpture">
  <div class="sculpture-stage" id="sculpture-stage" aria-hidden="true">
    <div class="sculpture-fallback">
      <div class="physical-object">
        {[0, 1, 2, 3, 4, 5].map((i) => <i style={`--layer:${i}`} />)}
      </div><div class="object-shadow"></div>
    </div>
  </div><span class="object-index mono"
    >{t.sculpture.index[0]}<br />{t.sculpture.index[1]}</span
  ><span class="object-note mono"
    >{t.sculpture.note[0]}<br />{t.sculpture.note[1]}</span
  ><div class="sculpture-control">
    <button
      type="button"
      id="assemble"
      aria-pressed="false"
      aria-label={t.sculpture.assembleLabel}
      ><span class="control-dot" aria-hidden="true"></span><span
        data-assembly-label>{t.sculpture.assemble}</span
      ><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"
        ><path
          d="M3 8h6V2M21 16h-6v6M9 8 2 1m13 15 7 7"
          stroke="currentColor"
          fill="none"
          stroke-width="1.5"></path></svg
      ></button
    ><button
      class="pause-motion"
      id="pause-scene"
      type="button"
      aria-pressed="false"
      aria-label={t.sculpture.pauseLabel}
      hidden>{t.common.pauseMotion}</button
    >
  </div><span class="sr-only" id="assembly-status" aria-live="polite"
    >{t.sculpture.statusPrototype}</span
  >
</div>
<script>
  import { initSculpture } from '@/lib/sculpture';
  const host = document.querySelector<HTMLElement>('#sculpture');
  if (host) initSculpture(host);
</script>
