---
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="request-object request-orbital" data-request-object data-stage="0">
  <div class="request-orbits" aria-hidden="true">
    <i></i><i></i><i></i><div class="request-core">
      <span class="compass-dial"></span><svg
        class="compass-needle"
        viewBox="0 0 100 100"
        fill="none"
        ><path d="M50 12 63 50 50 88 37 50Z" fill="#802e22"></path><path
          d="M50 12 63 50 50 44 37 50Z"
          fill="#fff0d5"></path><path d="M50 12 50 44 37 50Z" fill="#dfbb95"
        ></path><circle cx="50" cy="50" r="5" fill="#e8c7a1"></circle><circle
          cx="50"
          cy="50"
          r="2"
          fill="#8b3928"></circle></svg
      >
    </div>
    <span class="request-node node-product">{t.check.compassNodes.product}</span
    >
    <span class="request-node node-context">{t.check.compassNodes.context}</span
    >
    <span class="request-node node-human">{t.check.compassNodes.human}</span>
  </div>
  <div class="brief-caption">
    <span class="mono">{t.check.compassCaption}</span>
    <span data-brief-caption>{t.form.briefCaptions[0]}</span>
  </div>
  <button class="compass-motion" type="button" aria-pressed="false" hidden
    ><span aria-hidden="true">Ⅱ</span>
    <span data-motion-label>{t.common.pauseMotion}</span></button
  >
</div>
<script src="@/lib/request-compass.ts"></script>
<style>
  .request-orbital {
    display: block;
  }
  .request-orbital .brief-caption {
    position: relative;
    padding-top: 1rem;
    margin-top: 0.5rem;
  }
  .request-orbits {
    position: relative;
    width: min(100%, 400px);
    aspect-ratio: 1;
    margin: auto;
    perspective: 800px;
  }
  .request-orbits i {
    position: absolute;
    inset: 25px;
    border: 1px solid var(--accent);
    border-radius: 50%;
    transform: rotateY(55deg) rotateZ(-25deg);
  }
  .request-orbits i:nth-child(2) {
    transform: rotateY(-55deg) rotateZ(25deg);
    border-width: 5px;
  }
  .request-orbits i:nth-child(3) {
    transform: rotateX(70deg);
  }
  .request-core {
    position: absolute;
    inset: 34%;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: radial-gradient(
      circle at 30% 20%,
      #ed9c73,
      #c4472d 60%,
      #7f3021
    );
    color: #fff2df;
    font-size: 3rem;
    box-shadow: 12px 20px 30px #6d382522;
  }
  .request-node {
    position: absolute;
    font: 0.5rem var(--font-mono);
    padding: 0.4rem 0.7rem;
    background: var(--paper);
    border-radius: 30px;
    border: 1px solid var(--line);
  }
  .node-product {
    left: 2%;
    top: 25%;
  }
  .node-context {
    right: 0;
    top: 45%;
  }
  .node-human {
    bottom: 12%;
    left: 20%;
  }
  [data-stage='0'] .node-product,
  [data-stage='1'] .node-context,
  [data-stage='2'] .node-human {
    background: var(--ink);
    color: var(--paper);
  }
  @media (max-width: 640px) {
    .request-orbits {
      width: 230px;
    }
    .request-core {
      font-size: 1.7rem;
    }
    .request-node {
      font-size: 0.4rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .request-orbits i {
      transition: none;
    }
  }
  .request-orbits i {
    box-shadow:
      inset 1px 1px 0 #f0c4a1,
      1px 1px 0 #6e34272e;
  }
  .request-orbits i::after {
    content: '';
    position: absolute;
    top: 13%;
    left: 13%;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #efd6b7;
    border: 1px solid #ac553b;
  }
  .request-orbits::before {
    content: '';
    position: absolute;
    inset: 11%;
    border: 1px dashed #c4472d25;
    border-radius: 50%;
  }
  .request-core {
    inset: 32%;
    box-shadow:
      inset 1px 2px 2px #ffd5af9c,
      inset -2px -3px 3px #66271e80,
      8px 14px 24px #6d382526;
  }
  .compass-dial {
    position: absolute;
    inset: 9%;
    border: 1px solid #efb18b73;
    border-radius: 50%;
  }
  .compass-dial::before,
  .compass-dial::after {
    content: '';
    position: absolute;
    background: #efb18b50;
  }
  .compass-dial::before {
    width: 1px;
    height: 100%;
    left: 50%;
  }
  .compass-dial::after {
    height: 1px;
    width: 100%;
    top: 50%;
  }
  .compass-needle {
    position: absolute;
    inset: 9%;
    width: 82%;
    height: 82%;
    transform: rotate(-55deg);
    filter: drop-shadow(1px 3px 2px #62271950);
  }
  .request-node {
    z-index: 2;
  }
  .compass-motion {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.5rem 0;
    margin-top: 0.3rem;
    background: none;
    border: 0;
    color: var(--muted);
    font: 0.55rem var(--font-mono);
    cursor: pointer;
  }
  .compass-motion[hidden] {
    display: none;
  }
  .compass-motion:hover {
    color: var(--accent);
  }
  .compass-motion:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 2px;
  }
</style>
