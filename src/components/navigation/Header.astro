---
import Button from '@/components/ui/Button.astro';
import {
  useTranslations,
  path,
  translatePath,
  locales,
  localeNames,
  localeTags,
} from '@/i18n';
import type { Locale, RouteKey } from '@/i18n';
interface Props {
  lang: Locale;
  /** Set on pages whose counterpart is not in the route registry (articles). */
  alternates?: Partial<Record<Locale, string>>;
}
const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const other = locales.filter((locale) => locale !== lang);
---

<header class="wrap">
  <nav class="nav" aria-label={t.nav.label}>
    <a class="brand" href={path('home', lang)} aria-label={t.nav.brandHome}
      ><svg width="27" height="30" viewBox="0 0 27 30" aria-hidden="true"
        ><path d="M0 30V0h27v30h-8V8H8v22Z" fill="currentColor"></path></svg
      ><span>real<br />product<span class="brand-period">.</span></span></a
    ><span class="nav-caption mono"
      >{t.nav.caption[0]}<br />{t.nav.caption[1]}</span
    ><button
      class="menu-button"
      aria-expanded="false"
      aria-controls="navigation"
      ><span>{t.nav.menu}</span><span class="menu-glyph" aria-hidden="true"
        >+</span
      ></button
    ><div class="nav-links" id="navigation">
      {
        t.nav.items.map((item) => {
          const href = path(item.key as RouteKey, lang);
          return (
            <a href={href} aria-current={current === href ? 'page' : undefined}>
              {item.label}
            </a>
          );
        })
      }{
        other.map((locale) => (
          <a
            class="lang-switch"
            href={translatePath(current, locale, alternates)}
            lang={localeTags[locale]}
            hreflang={localeTags[locale]}
            aria-label={localeNames[locale]}
            data-event="language_switched"
          >
            <span aria-hidden="true">{locale.toUpperCase()}</span>
          </a>
        ))
      }<Button lang={lang} label={t.nav.cta} />
    </div>
  </nav>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const menu = document.querySelector<HTMLElement>('#navigation');
  function setOpen(open: boolean) {
    button?.setAttribute('aria-expanded', String(open));
    if (menu) menu.dataset.open = String(open);
  }
  button?.addEventListener('click', () =>
    setOpen(button.getAttribute('aria-expanded') !== 'true'),
  );
  document.addEventListener('keydown', (e) => {
    if (
      e.key === 'Escape' &&
      button?.getAttribute('aria-expanded') === 'true'
    ) {
      setOpen(false);
      button.focus();
    }
  });
</script>
