---
import { useTranslations, path } from '@/i18n';
import type { Locale } from '@/i18n';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="wrap review-bench" id="what-we-check">
  <div class="chapter-line">
    <span class="mono">{t.bench.chapter[0]}</span><span class="mono"
      >{t.bench.chapter[1]}</span
    >
  </div>
  <div class="bench-heading">
    <h2>
      {t.bench.heading[0]}<br />{t.bench.heading[1]}{' '}<em
        >{t.bench.headingEm}</em
      >
    </h2><p>
      {t.bench.copy}
    </p>
  </div>
  <div class="bench-grid">
    <div class="bench-index">
      <span class="mono">{t.bench.indexLabel}</span><p>
        {t.bench.indexCopy[0]}<br />{t.bench.indexCopy[1]}
      </p><a class="text-link" href={path('realityCheck', lang)}
        >{t.bench.indexLink} ↗</a
      >
    </div>
    <div class="lens-list">
      {
        t.coverage.map((lens, i) => (
          <details name="review-lens" open={i === 0}>
            <>
              <summary>
                <>
                  <span class="lens-number mono">0{i + 1}</span>
                  <strong>{lens.category}</strong>
                  <span class="lens-indicator" aria-hidden="true">
                    +
                  </span>
                </>
              </summary>
              <div class="lens-body">
                <>
                  <h3>{lens.title}</h3>
                  <p>{lens.description}</p>
                  <span class="lens-margin mono">{t.bench.evidence} ↗</span>
                </>
              </div>
            </>
          </details>
        ))
      }
    </div>
  </div>
</section>
