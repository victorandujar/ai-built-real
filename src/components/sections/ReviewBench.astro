---
import { coverage } from '@/config/coverage';
---

<section class="wrap review-bench" id="what-we-check">
  <div class="chapter-line">
    <span class="mono">02 / On the workbench</span><span class="mono"
      >One product. The whole picture.</span
    >
  </div>
  <div class="bench-heading">
    <h2>A second set<br />of <em>eyes.</em></h2><p>
      We follow the experience into the code, the data and the way it runs.
      Always in the context of your next release.
    </p>
  </div>
  <div class="bench-grid">
    <div class="bench-index">
      <span class="mono">THE SEVEN LENSES</span><p>
        Small details.<br />Connected consequences.
      </p><a class="text-link" href="/reality-check"
        >Inside the Reality Check ↗</a
      >
    </div>
    <div class="lens-list">
      {
        coverage.map(([category, title, description], i) => (
          <details name="review-lens" open={i === 0}>
            <>
              <summary>
                <>
                  <span class="lens-number mono">0{i + 1}</span>
                  <strong>{category}</strong>
                  <span class="lens-indicator" aria-hidden="true">
                    +
                  </span>
                </>
              </summary>
              <div class="lens-body">
                <>
                  <h3>{title}</h3>
                  <p>{description}</p>
                  <span class="lens-margin mono">FOLLOW THE EVIDENCE ↗</span>
                </>
              </div>
            </>
          </details>
        ))
      }
    </div>
  </div>
</section>
