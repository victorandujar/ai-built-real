---
import { useTranslations, path } from '@/i18n';
import type { Locale } from '@/i18n';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="reality-stage" data-scenes>
  <div class="wrap">
    <div class="chapter-line">
      <span class="mono">{t.scenes.chapter[0]}</span><span class="mono"
        >{t.scenes.chapter[1]}</span
      >
    </div>
    <div class="scene-heading">
      <h2>{t.scenes.heading[0]}<br /><em>{t.scenes.heading[1]}</em></h2><p>
        {t.scenes.copy[0]}<br />{t.scenes.copy[1]}
      </p>
    </div>
    <div class="scene-layout">
      <div class="scene-switches" role="tablist" aria-label={t.scenes.tablist}>
        {
          t.scenes.items.map((scene, i) => (
            <button
              type="button"
              role="tab"
              id={`scene-tab-${i}`}
              aria-controls={`scene-panel-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              <>
                <span class="mono">0{i + 1}</span>
                <span>{scene.name}</span>
                <span aria-hidden="true">↗</span>
              </>
            </button>
          ))
        }
      </div>
      <div class="scene-panels">
        <div
          class="reality-sculpture"
          data-reality-sculpture
          aria-hidden="true"
        >
          <div class="orbit-fallback"><i></i><i></i><i></i><b></b></div>
          <span class="sculpture-coordinate mono">{t.scenes.coordinate}</span>
          <span class="sculpture-index mono">01—04</span>
        </div>
        {
          t.scenes.items.map((scene, i) => (
            <article
              role="tabpanel"
              id={`scene-panel-${i}`}
              aria-labelledby={`scene-tab-${i}`}
              tabindex="0"
              hidden={i !== 0}
            >
              <div class="scene-depth-control">
                <label for={`scene-depth-${i}`}>
                  {t.scenes.shiftPerspective} <span aria-hidden="true">↔</span>
                </label>
                <input
                  id={`scene-depth-${i}`}
                  class="scene-depth"
                  type="range"
                  min="0"
                  max="100"
                  value="0"
                  aria-valuetext={t.scenes.frontPerspective}
                />
                <button type="button" class="scene-replay">
                  {t.scenes.replay} <span aria-hidden="true">↺</span>
                </button>
              </div>
              <div class="scene-caption">
                <>
                  <h3>{scene.title}</h3>
                  <p>{scene.copy}</p>
                  <span class="scene-footnote">↳ {scene.note}</span>
                </>
              </div>
            </article>
          ))
        }
      </div>
    </div>
    <noscript
      ><p class="scene-noscript">
        {t.scenes.noscript}{' '}
        <a href={path('realityCheck', lang)}>{t.scenes.noscriptLink}</a>
      </p></noscript
    >
  </div>
</section>
