---
import Button from '@/components/ui/Button.astro';
import Sculpture from '@/components/brand/Sculpture.astro';
---

<section class="hero wrap">
  <div class="hero-topline">
    <p class="eyebrow">
      <span class="live-dot"></span> AI-built → Real-world ready
    </p><span class="mono">A new beginning, after the build.</span>
  </div><div class="hero-grid">
    <div class="hero-copy">
      <h1>
        <span class="hero-line">Built with AI.</span><span class="hero-line"
          >Ready for</span
        ><em class="hero-line">real life.</em>
      </h1><p class="hero-intro">
        You made something that works.<br />Let's make sure it works <strong
          >out there.</strong
        >
      </p><div class="actions">
        <Button event="hero_cta_clicked" /><a
          href="/reality-check"
          class="text-link"
          >What happens in a check <span aria-hidden="true">↗</span></a
        >
      </div><p class="hero-note">
        A human review. A clear next move. Still your product.
      </p>
    </div><Sculpture />
  </div><div class="tool-strip">
    <span class="mono">Built with whatever.<br />Ready for whoever.</span><div
      class="tool-names"
    >
      <span>Lovable</span><span>Cursor</span><span>Replit</span><span>Bolt</span
      ><span>Claude Code</span><span>Codex</span><span class="muted"
        >&amp; everything after.</span
      >
    </div>
  </div>
</section>
