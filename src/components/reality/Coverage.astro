---
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="coverage">
  {
    t.coverage.map((lens, i) => (
      <details open={i === 0}>
        <>
          <summary>
            <span>
              <>
                <small class="mono">0{i + 1}</small>
                <strong>{lens.category}</strong>
              </>
            </span>
          </summary>
          <h3 class="mb-4">{lens.title}</h3>
          <p>{lens.description}</p>
        </>
      </details>
    ))
  }
</div>
