---
import { useTranslations, path } from '@/i18n';
import type { Locale, RouteKey } from '@/i18n';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="wrap footer">
  <div class="footer-top">
    <a class="brand" href={path('home', lang)}>{t.footer.brand}</a><div
      class="footer-links"
    >
      {
        t.nav.items.map((item) => (
          <a href={path(item.key as RouteKey, lang)}>{item.label}</a>
        ))
      }
    </div>
  </div><div class="footer-bottom">
    <span
      >© {new Date().getFullYear()}{' '}
      {t.meta.shortName}. {t.footer.tagline}</span
    ><div class="footer-links">
      <a href={path('privacy', lang)}>{t.footer.privacy}</a><a
        href={path('terms', lang)}>{t.footer.terms}</a
      ><a href={path('rss', lang)}>{t.footer.rss}</a>
    </div><span>{t.footer.human}</span>
  </div>
</footer>
