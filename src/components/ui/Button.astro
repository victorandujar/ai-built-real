---
import { site } from '@/config/site';
import Arrow from './Arrow.astro';
interface Props {
  href?: string;
  label?: string;
  light?: boolean;
  event?: string;
}
const { href = '/check', label = site.cta, light = false, event } = Astro.props;
---

<a href={href} class:list={['button', { light }]} data-event={event}
  ><span>{label}</span><span class="button-icon"><Arrow /></span></a
>
