---
import Base from '@/layouts/Base.astro';
import CheckForm from '@/components/forms/CheckForm.astro';
import { site } from '@/config/site';
---

<Base
  title="Start your Reality Check"
  description="Show us your AI-built product and what comes next. Request a focused human review before launch."
  noindex
  ><section class="wrap check-intro">
    <aside class="check-sidebar">
      <p class="eyebrow"><span class="live-dot"></span> The Reality Check</p><h1
      >
        You built it.<br />Let's <em>look at it.</em>
      </h1><p class="lead muted">
        Tell us a little about your product.<br />We'll take it from there,
        together.
      </p><div class="check-facts">
        <span>About 3 minutes</span><span>No payment required</span>
      </div><div class="founder-line">
        <strong>{site.founder.name}</strong><p class="hint">
          I read every request. If it's a fit, we'll agree the scope, timing and
          fee before starting any work.
        </p>
      </div><p class="hint mt-8">
        A product link is enough to start.<br />Keep passwords, keys and
        customer data private.
      </p>
    </aside><CheckForm />
  </section></Base
>
