---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/sections/Hero.astro';
import Closing from '@/components/sections/Closing.astro';
import RealityScenes from '@/components/sections/RealityScenes.astro';
import ReviewBench from '@/components/sections/ReviewBench.astro';
import Report from '@/components/reality/Report.astro';
import { getCollection } from 'astro:content';
import '@/styles/editorial.css';
const posts = (await getCollection('learn'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title="Built with AI. Ready for real life."
  ><Hero />
  <section class="wrap opening-spread" aria-labelledby="opening-title">
    <div class="opening-margin">
      <span class="mono">A NOTE TO THE BUILDER</span><span
        class="opening-arrow"
        aria-hidden="true">↳</span
      >
    </div>
    <div class="opening-main">
      <h2 id="opening-title">
        You had an idea.<br />This time,<br /><span class="opening-built"
          >you built it.<svg
            aria-hidden="true"
            viewBox="0 0 600 35"
            preserveAspectRatio="none"
            ><path d="M4 22Q290 1 594 12M120 31Q360 12 530 22"></path></svg
          ></span
        >
      </h2><div class="opening-bottom">
        <p class="editorial-aside">That's a<br /><em>big deal.</em></p><p>
          AI changed who gets to build. We think that's extraordinary. You made
          something that works. Now comes the next chapter: letting other people
          in.
        </p>
      </div>
    </div>
  </section>
  <RealityScenes />
  <ReviewBench />
  <section class="report-chapter" aria-labelledby="report-heading">
    <div class="wrap">
      <div class="chapter-line">
        <span class="mono">03 / What you leave with</span><span class="mono"
          >Less noise. A next move.</span
        >
      </div>
      <div class="report-spread">
        <div class="report-copy">
          <h2 id="report-heading">Clarity,<br /><em>in your hands.</em></h2><p>
            A short, prioritised report. What blocks your next release, what to
            fix soon, and what is already good enough.
          </p><p>
            Every finding comes with evidence and a next action. Use it
            yourself, with AI, or with us.
          </p><a href="/check" class="text-link">Get a clear next move ↗</a>
        </div><div class="report-desk">
          <span class="desk-annotation mono"
            >AN EXAMPLE / EXPLORE THE PRIORITIES</span
          ><div class="report-explorer" data-report-explorer>
            <div class="report-filters" aria-label="Explore example priorities">
              <button type="button" data-filter="all" aria-pressed="true"
                >The whole picture</button
              ><button type="button" data-filter="blockers" aria-pressed="false"
                >Launch blockers</button
              >
            </div>
            <Report />
            <p class="report-explore-hint">
              Open a finding to see the thinking behind it.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="wrap human-interlude" aria-labelledby="human-heading">
    <div class="human-question">
      <span class="mono">A FAIR QUESTION</span><h2 id="human-heading">
        “Couldn't I<br />just ask <em>AI?</em>”
      </h2>
    </div><div class="human-answer">
      <span class="answer-mark" aria-hidden="true">↳</span><h3>
        Absolutely.<br />We do too.
      </h3><p>
        The hard part is deciding which answer matters for your product, your
        users and your next launch. Someone needs to test the assumptions,
        follow the evidence and stand behind the recommendation.
      </p><div class="human-signoff">
        <span class="signature">Víctor Andújar</span><span class="mono"
          >THE HUMAN BEHIND REAL PRODUCT</span
        >
      </div><a href="/about" class="text-link"
        >Meet the person behind the check ↗</a
      >
    </div>
  </section>
  <section class="path-chapter">
    <div class="wrap">
      <div class="chapter-line">
        <span class="mono">04 / From here, forward</span><span class="mono"
          >Still your product. Always.</span
        >
      </div><div class="path-heading">
        <h2>One check.<br /><em>A way forward.</em></h2><p>
          First product? First users? First paying customers?<br />This is the
          moment we're here for.
        </p>
      </div><ol class="release-path">
        <li>
          <span class="path-number" aria-hidden="true">01</span><div
            class="path-body"
          >
            <span class="mono">UNDERSTAND</span><h3>Reality Check</h3><p>
              Show us what you've built. We agree the scope and fee, review the
              product, then walk you through a short, prioritised report.
            </p><a href="/check" class="text-link">Start with a check ↗</a>
          </div>
        </li><li>
          <span class="path-number" aria-hidden="true">02</span><div
            class="path-body"
          >
            <span class="mono">MAKE IT READY / OPTIONAL</span><h3>
              Reality Sprint
            </h3><p>
              Want help with the fixes? We agree a focused scope, work through
              the important issues and verify the changes.
            </p><a
              href="/check?interest=sprint"
              class="text-link"
              data-event="reality_sprint_clicked">Explore a sprint ↗</a
            >
          </div>
        </li><li>
          <span class="path-number" aria-hidden="true">↗</span><div
            class="path-body"
          >
            <span class="mono">KEEP GOING</span><h3>
              Ship.<br /><em>Keep building.</em>
            </h3><p>
              Take the next step knowing what works, what needs attention and
              what can wait.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>
  <section class="wrap journal-chapter">
    <div class="journal-heading">
      <div>
        <span class="mono">THE FIELD NOTES</span><h2>
          A little more<br /><em>perspective.</em>
        </h2>
      </div><a href="/learn" class="text-link">Open the library ↗</a>
    </div><div class="journal-shelf">
      {
        posts.map((p, i) => (
          <a class={`journal-volume volume-${i}`} href={`/learn/${p.id}`}>
            <>
              <div class={`insight-orbit orbit-${i}`} aria-hidden="true">
                <>
                  <i />
                  <i />
                  <i />
                  <span>0{i + 1}</span>
                </>
              </div>
              <div class="volume-caption">
                <>
                  <span class="mono">{p.data.category}</span>
                  <h3>{p.data.title}</h3>
                  <span class="volume-link" aria-hidden="true">
                    ↗
                  </span>
                </>
              </div>
            </>
          </a>
        ))
      }
    </div>
  </section>
  <Closing />
</Base>
<script src="@/lib/editorial.ts"></script>
