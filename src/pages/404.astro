---
import Base from '@/layouts/Base.astro';
import Button from '@/components/ui/Button.astro';
---

<Base title="Page not found" noindex
  ><section class="wrap section">
    <p class="eyebrow">404 / A small detour</p><h1>
      This page<br />isn't here.
    </h1><p class="lead muted mt-8">
      Let's get you back to something useful.
    </p><div class="actions mt-8">
      <Button href="/" label="Back to the start" /><a
        class="text-link"
        href="/learn">Read the field notes ↗</a
      >
    </div>
  </section></Base
>
