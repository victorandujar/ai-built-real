---
import ArticleView from '@/views/ArticleView.astro';
import { getArticles } from '@/lib/content';
export async function getStaticPaths() {
  return (await getArticles('en')).map((post) => ({
    params: { id: post.slug },
    props: { post },
  }));
}
const { post } = Astro.props;
---

<ArticleView lang="en" post={post} />
