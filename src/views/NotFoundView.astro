---
import Base from '@/layouts/Base.astro';
import Button from '@/components/ui/Button.astro';
import { useTranslations, path } from '@/i18n';
import type { Locale } from '@/i18n';
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Base lang={lang} title={t.notFound.title} noindex
  ><section class="wrap section">
    <p class="eyebrow">{t.notFound.eyebrow}</p><h1>
      {t.notFound.h1[0]}<br />{t.notFound.h1[1]}
    </h1><p class="lead muted mt-8">{t.notFound.lead}</p><div
      class="actions mt-8"
    >
      <Button
        lang={lang}
        href={path('home', lang)}
        label={t.notFound.backHome}
      /><a class="text-link" href={path('learn', lang)}
        >{t.notFound.readNotes} ↗</a
      >
    </div>
  </section></Base
>
