---
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { useTranslations, formatDate } from '@/i18n';
import type { Locale } from '@/i18n';
import { getLegal } from '@/lib/content';
interface Props {
  lang: Locale;
  doc: 'privacy' | 'terms';
}
const { lang, doc } = Astro.props;
const t = useTranslations(lang);
const entry = await getLegal(doc, lang);
const { Content } = await render(entry);
---

<Base
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  noindex
>
  <section class="wrap page-hero">
    <p class="eyebrow">{t.legal.eyebrow}</p>
    <h1>{entry.data.title}</h1>
    <p class="lead">
      {t.legal.updated}{' '}<time datetime={entry.data.updated}
        >{formatDate(entry.data.updated, lang)}</time
      >
    </p>
  </section>
  <section class="wrap section">
    <div class="prose legal"><Content /></div>
  </section>
</Base>
