---
import '@/styles/global.css';
import Header from '@/components/navigation/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import SEO from '@/components/seo/SEO.astro';
import { useTranslations, localeTags, path } from '@/i18n';
import type { Locale } from '@/i18n';
interface Props {
  lang: Locale;
  title: string;
  description?: string;
  noindex?: boolean;
  /** Explicit per-locale URLs for pages the route registry cannot resolve. */
  alternates?: Partial<Record<Locale, string>>;
  article?: {
    title: string;
    description: string;
    published: string;
    updated?: string;
  };
}
const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
---

<!doctype html>
<html lang={localeTags[lang]}>
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    /><meta name="theme-color" content="#f0eee7" /><SEO {...Astro.props} /><link
      rel="icon"
      href="/favicon.svg"
      type="image/svg+xml"
    /><link rel="icon" href="/icon.png" type="image/png" sizes="192x192" /><link
      rel="apple-touch-icon"
      href="/apple-touch-icon.png"
    /><link
      rel="alternate"
      type="application/rss+xml"
      title={t.meta.rssTitle}
      href={path('rss', lang)}
    /></head
  ><body
    ><a class="skip" href="#main">{t.common.skipToContent}</a><Header
      lang={lang}
      alternates={alternates}
    /><main id="main">
      <slot />
    </main><Footer lang={lang} /><script>
      import '@/lib/analytics';
      import '@/lib/motion';
    </script></body
  >
</html>
